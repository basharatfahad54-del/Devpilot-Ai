#OPENROUTER_API_KEY=
#OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENROUTER_MODEL=gemini-2.5-flash

DEVPILOT_WORKSPACE=./workspace
DEVPILOT_MAX_STEPS=10
DEVPILOT_REQUIRE_APPROVAL=true
DEVPILOT_LOG_LEVEL=INFO
DEVPILOT_MAX_RESPONSE_SIZE=10000
DEVPILOT_MAX_TOOL_OUTPUT=5000
DEVPILOT_MAX_FILE_SIZE=1048576
DEVPILOT_MAX_SEARCH_RESULTS=100
DEVPILOT_REQUEST_TIMEOUT=30
DEVPILOT_RETRY_ATTEMPTS=3
DEVPILOT_RETRY_BACKOFF=0.5

